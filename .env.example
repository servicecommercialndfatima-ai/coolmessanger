# Copiez ce fichier sous le nom .env puis adaptez les valeurs. Ne partagez jamais .env.

# Clé de signature des sessions (32 caractères minimum).
# Laissez vide : une clé aléatoire est alors créée et conservée dans data/.secret_key.
# Pour en générer une :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Dossier des données (base, messages vocaux, clé). Par défaut : ./data
# DATA_DIR=

# Base de données. Par défaut : SQLite dans DATA_DIR.
# Sur un hébergeur sans disque persistant, indiquez une base PostgreSQL externe (Neon, Supabase…) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Documentation interactive /docs (à laisser désactivée en production).
# ENABLE_DOCS=0

# SMS classiques via Twilio (facultatif). Le bouton SMS n'apparaît que si ces trois valeurs sont renseignées.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Nombre maximal de SMS par utilisateur et par jour (chaque SMS est facturé).
SMS_DAILY_LIMIT=10
